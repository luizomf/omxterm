index a4fc24a80..92fd30cd7 100644
--- a/src/terminal/kitty/graphics_image.zig
+++ b/src/terminal/kitty/graphics_image.zig
@@ -20,2 +20,5 @@ const max_dimension = 10000;
-/// Maximum size in bytes, taken from Kitty.
-const max_size = 400 * 1024 * 1024; // 400MB
+/// Maximum accepted direct load/decode input for OMXTerm's bounded paths.
+const max_size = 32 * 1024 * 1024; // 32 MiB
+
+/// Maximum accepted decoded source area for OMXTerm's Pi/Chafa subset.
+const max_pixels = 4_194_304;
@@ -530,2 +533,6 @@ pub const LoadingImage = struct {
-        // Decode the png if we have to
-        if (img.format == .png) try self.decodePng(alloc);
+        // Reject oversized PNG dimensions from the fixed IHDR before the
+        // decoder can allocate the completed RGBA buffer.
+        if (img.format == .png) {
+            try self.validatePngDimensions();
+            try self.decodePng(alloc);
+        }
@@ -535,0 +543,2 @@ pub const LoadingImage = struct {
+        if (@as(u64, img.width) * @as(u64, img.height) > max_pixels)
+            return error.DimensionsTooLarge;
@@ -623,0 +633,19 @@ pub const LoadingImage = struct {
+    fn validatePngDimensions(self: *const LoadingImage) !void {
+        const data = self.data.items;
+        const signature = "\x89PNG\r\n\x1a\n";
+        if (data.len < 24 or !std.mem.eql(u8, data[0..8], signature) or
+            !std.mem.eql(u8, data[12..16], "IHDR") or
+            std.mem.readInt(u32, data[8..12], .big) != 13)
+        {
+            return error.InvalidData;
+        }
+
+        const width = std.mem.readInt(u32, data[16..20], .big);
+        const height = std.mem.readInt(u32, data[20..24], .big);
+        if (width == 0 or height == 0) return error.DimensionsRequired;
+        if (width > max_dimension or height > max_dimension)
+            return error.DimensionsTooLarge;
+        if (@as(u64, width) * @as(u64, height) > max_pixels)
+            return error.DimensionsTooLarge;
+    }
+
