diff --git a/wasm/src/restty.zig b/wasm/src/restty.zig
index 28bdd04..843e434 100644
--- a/wasm/src/restty.zig
+++ b/wasm/src/restty.zig
@@ -625,0 +626,16 @@ pub export fn restty_scroll_viewport(handle: ?*Restty, delta: i32) u32 {
+pub export fn restty_set_scrollback_limits(
+    handle: ?*Restty,
+    max_lines: u32,
+    max_bytes: u32,
+) u32 {
+    const h = handle orelse return @intFromEnum(ErrorCode.invalid_handle);
+    if (max_lines == 0) {
+        h.term.setScrollbackMaxBytes(0);
+        h.term.setScrollbackMaxLines(null);
+    } else {
+        h.term.setScrollbackMaxBytes(max_bytes);
+        h.term.setScrollbackMaxLines(max_lines);
+    }
+    return @intFromEnum(ErrorCode.ok);
+}
+
