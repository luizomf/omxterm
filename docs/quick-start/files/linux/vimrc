" Optional Vim preferences; not required by OMXTerm.
set nocompatible
syntax on
set nocursorline
set backupcopy=yes
set expandtab
set tabstop=2
set shiftwidth=2
set noautoindent
set nosmartindent
set mouse=
set clipboard=unnamed
set nowrap
set backspace=indent,eol,start
set formatoptions-=t
set nostartofline
set ruler
set showmatch
set showmode
set showcmd
set textwidth=80
set hlsearch
set incsearch
set belloff=all

set notermguicolors
set t_Co=256
colorscheme slate
set background=dark
highlight Normal ctermbg=NONE guibg=NONE
highlight NonText ctermbg=NONE guibg=NONE
highlight EndOfBuffer ctermbg=NONE guibg=NONE
highlight LineNr ctermbg=NONE guibg=NONE
highlight SignColumn ctermbg=NONE guibg=NONE
highlight RedundantWhitespace ctermbg=blue guibg=blue
match RedundantWhitespace /\s\+$\| \+\ze\t/

" Restore the cursor position when reopening a file.
augroup QuickStartPosition
  autocmd!
  autocmd BufReadPost * if line("'\"") > 0 && line("'\"") <= line("$") | exe "normal! g`\"" | endif
augroup END

let mapleader = " "
inoremap jj <Esc>
nnoremap <leader>w :w<CR>
nnoremap <leader>h :noh<CR>
nnoremap <leader><Tab> <C-^>
nnoremap <Tab> :bnext<CR>
nnoremap <S-Tab> :bprevious<CR>
nnoremap <leader>bd :bdelete<CR>
nnoremap <leader>bu <C-^>

" Keep terminal cursor shapes distinct between normal and insert mode.
let &t_SI = "\<Esc>[6 q"
let &t_EI = "\<Esc>[2 q"
set guicursor=n-v-c:block,i-ci-ve:ver25,r-cr:hor20,o:hor50

" Session files are executable Vim commands: source only your own files.
let s:session_dir = expand('~/.vim/sessions')
function! s:session_file() abort
  " Hash the full path so punctuation and case cannot merge distinct sessions.
  return s:session_dir . '/' . sha256(getcwd()) . '.vim'
endfunction
function! s:load_session() abort
  if argc() == 0 && filereadable(s:session_file())
    execute 'source' fnameescape(s:session_file())
  endif
endfunction
function! s:save_session() abort
  if argc() == 0
    if !isdirectory(s:session_dir)
      call mkdir(s:session_dir, 'p', 0700)
    endif
    execute 'mksession!' fnameescape(s:session_file())
  endif
endfunction
augroup QuickStartSession
  autocmd!
  autocmd VimEnter * call s:load_session()
  autocmd VimLeavePre * call s:save_session()
augroup END
