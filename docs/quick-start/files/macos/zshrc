# Interactive Zsh preferences for the OMXTerm quick start.
[[ -o interactive ]] || return

HISTFILE="$HOME/.zsh_history"
HISTSIZE=1000
SAVEHIST=2000
setopt APPEND_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
unsetopt BEEP

PROMPT='%B%F{green}%n@%m%f%b:%B%F{blue}%~%f%b%(!.#.$) '
alias ls='ls -G'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

autoload -Uz compinit
compinit

export EDITOR=vim
export VISUAL=vim
bindkey -v
bindkey -M viins 'jj' vi-cmd-mode
