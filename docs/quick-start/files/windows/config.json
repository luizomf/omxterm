{
  "version": 1,
  "confirmClose": true,
  "logLevel": "info",
  "windowsShell": "C:\\Program Files\\Git\\bin\\bash.exe",
  "theme": {
    "path": "./themes/omtheme.json"
  },
  "font": {
    "size": 16,
    "lineHeight": 1.0,
    "ligatures": true
  },
  "terminal": {
    "padding": {
      "top": 0,
      "right": 8,
      "bottom": 8,
      "left": 8
    }
  },
  "scrollback": { "lines": 10000 },
  "keyboard": { "optionAsAlt": "none" },
  "window": { "alwaysOnTop": false },
  "keybinds": {
    "quit": "Control+Alt+Shift+Q",
    "copy": "Control+Shift+C",
    "paste": "Control+Shift+V",
    "selectAll": "Control+Shift+A",
    "newWindow": "Control+Shift+N",
    "closeWindow": "Control+Shift+Q",
    "newTab": "Control+Shift+T",
    "closeTab": "Control+Shift+W",
    "nextTab": "Control+PageDown",
    "previousTab": "Control+PageUp",
    "selectTab1": "Alt+1",
    "selectTab2": "Alt+2",
    "selectTab3": "Alt+3",
    "selectTab4": "Alt+4",
    "selectTab5": "Alt+5",
    "selectTab6": "Alt+6",
    "selectTab7": "Alt+7",
    "selectTab8": "Alt+8",
    "selectTab9": "Alt+9",
    "zoomIn": "Control+Plus",
    "zoomOut": "Control+-",
    "actualSize": "Control+0",
    "toggleFullScreen": "Control+Shift+F",
    "toggleSnippets": "Control+Shift+S",
    "toggleTabBar": "Control+Shift+B",
    "reloadConfig": "Control+Shift+,"
  }
}
