#!/bin/sh
# OMXTerm launcher for DEB and RPM installations.
#
# OMXTerm deliberately disables the Chromium sandbox on Linux (ADR 0024).
# Chromium initializes its sandbox during bootstrap, before application code
# runs, so the flag must precede every user argument here. No setuid
# chrome-sandbox helper or AppArmor user-namespace profile is installed.
exec /opt/OMXTerm/omxterm --no-sandbox "$@"
