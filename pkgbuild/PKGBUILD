#Maintainer: ruscher

# BigLinux package for OMXTerm, built from the Git repository like the other
# BigLinux packages (pkgver/pkgrel from the build date). Native modules are
# compiled on the build host for x86_64 or aarch64; npm and Electron downloads
# need network access during build(). packaging/arch/PKGBUILD builds the same
# package from a local checkout instead.
#
# The default branch is built; another one with, for example:
#   OMXTERM_BRANCH=feature/ashyterm-ui-parity makepkg -si

pkgname=omxterm
pkgdesc="Open-source terminal with split panes, SSH sessions, an SFTP file manager, file hover previews, output highlighting, a command manager and an optional AI assistant"

depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'dbus'
    'expat'
    'fontconfig'
    'glib2'
    'glibc'
    'gtk3'
    'hicolor-icon-theme'
    'libcups'
    'libgcc'
    'libstdc++'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
    'xdg-utils'
    'bash' # /usr/bin/sh for the /usr/bin/omxterm launcher
)
optdepends=(
    'openssh: SSH sessions, Quick Connect and remote files over SFTP'
    'ollama: local models for the AI assistant'
    'poppler: first-page previews, page counts and titles of PDF files'
    'xorg-xrandr: new windows open on the active monitor under KDE Plasma Wayland'
)
# node-pty's own node-gyp install script is skipped (see build()): the
# project's postinstall compiles pty.node with the C++ compiler and pinned
# Node-API headers.
makedepends=(
    'git'
    'nodejs'
    'npm'
    'gcc'
    'patch'
)
# Electron ships prebuilt, already-stripped binaries.
options=('!strip' '!debug')

# makepkg reads this file more than once (again under fakeroot); one build
# time keeps pkgver, pkgrel and the package file name in step even when the
# build crosses a minute. The exported value reaches the fakeroot pass.
export OMXTERM_BUILD_TIME="${OMXTERM_BUILD_TIME:-$(date +%s)}"
pkgver=$(date -d "@${OMXTERM_BUILD_TIME}" +%y.%m.%d)
pkgrel=$(date -d "@${OMXTERM_BUILD_TIME}" +%H%M)

arch=('x86_64' 'aarch64')
license=('MIT')
url="https://github.com/ruscher/${pkgname}"
_branch="${OMXTERM_BRANCH:-main}"
source=("git+${url}.git#branch=${_branch}")
md5sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}"
    local _arch
    case "${CARCH}" in
        x86_64) _arch=x64 ;;
        aarch64) _arch=arm64 ;;
        *) printf 'Unsupported architecture: %s\n' "${CARCH}" >&2; return 1 ;;
    esac

    # Dependency install scripts are skipped; the project's postinstall
    # installs Electron and builds node-pty for this host.
    npm ci --ignore-scripts --no-audit --no-fund
    npm run postinstall
    npm run build
    node scripts/prepare-linux-launcher.mjs
    node node_modules/electron-builder/cli.js --config electron-builder.yml \
        --linux dir "--${_arch}" --publish never
}

package() {
    cd "${srcdir}/${pkgname}"
    local _unpacked=release/linux-unpacked
    if [[ "${CARCH}" == aarch64 ]]; then
        _unpacked=release/linux-arm64-unpacked
    fi

    install -d "${pkgdir}/usr/lib/${pkgname}"
    cp -a "${_unpacked}/." "${pkgdir}/usr/lib/${pkgname}/"
    # The Chromium sandbox is disabled on Linux (ADR 0024); never setuid.
    chmod 0755 "${pkgdir}/usr/lib/${pkgname}/chrome-sandbox"
    # Electron ships its Vulkan loader with symbols; options=('!strip')
    # leaves the prestripped Electron binaries alone, so strip it here.
    if [[ -f "${pkgdir}/usr/lib/${pkgname}/libvulkan.so.1" ]]; then
        strip --strip-unneeded "${pkgdir}/usr/lib/${pkgname}/libvulkan.so.1"
    fi

    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/bin/sh
# OMXTerm disables the Chromium sandbox on Linux (ADR 0024). Chromium decides
# during bootstrap, before application code runs, so the flag comes first.
# A parent Electron application (an editor's terminal, for example) may export
# ELECTRON_RUN_AS_NODE, which would start the binary as plain Node.js.
unset ELECTRON_RUN_AS_NODE
exec /usr/lib/omxterm/omxterm --no-sandbox "$@"
EOF

    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/${pkgname}.desktop" <<'EOF'
[Desktop Entry]
Name=OMXTerm
Comment=Open-source personal desktop terminal
Exec=/usr/bin/omxterm %U
Terminal=false
Type=Application
Icon=omxterm
StartupWMClass=omxterm
Categories=System;TerminalEmulator;
Keywords=terminal;shell;ssh;sftp;console;command;prompt;
EOF

    # Theme icons at every size, so menus and panels never scale one bitmap.
    install -d "${pkgdir}/usr/share/icons"
    cp -a assets/icons/hicolor "${pkgdir}/usr/share/icons/"
    find "${pkgdir}/usr/share/icons/hicolor" -type d -exec chmod 755 {} +
    find "${pkgdir}/usr/share/icons/hicolor" -type f -exec chmod 644 {} +

    local _licenses="${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm644 LICENSE "${_licenses}/LICENSE"
    install -Dm644 THIRD_PARTY_NOTICES.md "${_licenses}/THIRD_PARTY_NOTICES.md"
    cp -a "${_unpacked}/resources/licenses" "${_licenses}/licenses"
    install -Dm644 "${_unpacked}/LICENSE.electron.txt" \
        "${_licenses}/LICENSE.electron.txt"
    install -Dm644 "${_unpacked}/LICENSES.chromium.html" \
        "${_licenses}/LICENSES.chromium.html"

    if [ -f README.md ]; then
        install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    fi
}
